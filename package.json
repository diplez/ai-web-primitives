{
  "name": "ai-web-primitives-monorepo",
  "private": true,
  "description": "Monorepo de los paquetes de componentes de diplez para interfaces de IA.",
  "author": "diplez",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm test --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint . && npm run lint:arch --workspaces --if-present",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run format:check && npm run validate --workspaces",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "commit-msg": "node scripts/validate-commit-msg.mjs $1",
    "pre-commit": "npm run lint && npm run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-wc": "^3.1.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "simple-git-hooks": "^2.14.0",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.2"
  }
}
